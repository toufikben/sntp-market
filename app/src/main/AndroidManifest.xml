<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      No cloud backup, deliberately.

      Everything this app owns is either an identity or a paid right, and both are
      backed up by default: `device_id.txt` sits in filesDir, and DataStore holds
      the entitlement tier, the Play SKU and the shop unlocks. Auto-backup would
      restore all of it onto a new phone, which means

        · a lapsed or refunded subscriber gets Pro back for free by installing on
          a fresh device, and
        · one physical person can vote from many devices, because the restored
          device_id is the identity the server trusts for reputation and for the
          one-vote-per-20-minutes rule.

      There is nothing here worth backing up: the market state, week, shops and
      history are all re-fetched on first launch, and the settings are one screen.
    -->
    <application
        android:name=".SntpApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sntp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Home-screen widget.

          exported="true" is required, not a choice: APPWIDGET_UPDATE is sent by
          the system (and by the launcher when the widget is placed), which counts
          as an external sender. Declaring it false — the instinct for a receiver
          with an intent filter — silently disables every update path except the
          app's own, so the widget would appear and then never change again.

          Nothing is exposed by this: the receiver reads the local cache and
          redraws. A hostile app triggering it can only make the widget re-read a
          row it already had.
        -->
        <receiver
            android:name=".widget.StatusWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status_info" />
        </receiver>

    </application>

</manifest>
