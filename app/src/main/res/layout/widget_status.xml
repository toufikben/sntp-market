<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget layout. RemoteViews only understands the classic view set, so this is a
  LinearLayout, not Compose. Text is sized for a glance from arm's length, and
  start/end gravity keeps it correct in RTL.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:text="@string/status_unknown" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textColor="@color/widget_text_primary"
        android:text="@string/loading" />

    <TextView
        android:id="@+id/widget_trust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:text="@string/trust_seed" />

</LinearLayout>
