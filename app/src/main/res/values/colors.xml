<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget colours, kept as literals because RemoteViews renders outside Compose and
  cannot read the palette. Values mirror LightPalette so the widget and the app
  agree; the launcher decides the surrounding wallpaper, so the card carries its
  own opaque background rather than following the system dark theme.
-->
<resources>
    <color name="widget_bg">#FFF6F1E7</color>
    <color name="widget_text_primary">#FF1A1A1A</color>
    <color name="widget_text_secondary">#FF5A5A5A</color>
    <!--
      These three mirror the palette's open/closed/unknown. They were a shade
      lighter than the palette and were darkened with it: on the 13sp trust line
      and the "موثّق" badge the lighter green and amber fell under the 4.5:1
      minimum for small text, which on a card read outdoors at 5 a.m. is the
      difference between legible and decorative.
    -->
    <color name="widget_open">#FF197A43</color>
    <color name="widget_closed">#FFB23A2E</color>
    <color name="widget_unknown">#FF7C5F16</color>

    <!--
      Window background, per mode. This is what the OS paints before the first
      Compose frame and what the Android 12+ splash screen uses. The platform
      default is white, so a dark-mode user got a white flash on every cold
      start — on an app built to be read at 5 a.m. Values mirror the palette.
    -->
    <color name="window_bg">#FFF6F1E7</color>
</resources>
